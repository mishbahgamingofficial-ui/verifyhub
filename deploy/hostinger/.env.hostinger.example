# VerifyHub — .env for the HOSTINGER VPS (/opt/verifyhub/.env).
# Copy to .env and fill in real values. NEVER commit a real .env to git.
# Token ko chat me mat bhejo — sirf yahan server par bharo.

# Bot token from @BotFather. SAME token as on Render — the API uses it to
# check the Telegram initData signature. If the two sides differ, every
# login returns 401.
BOT_TOKEN=
# Bot username without @, e.g. verifyhub_bot
BOT_USERNAME=Testing_joinbot
# Your Hostinger domain, with https and trailing slash.
# This is the Mini App URL Telegram opens.
MINI_APP_URL=https://glaxfy.in/frontend/
# Official registration website users must register on.
REGISTRATION_URL=https://www.dmplay20.com/#/register?invitationCode=77254102278
# IMPORTANT: use the EXTERNAL database URL from Render here, not the
# internal one. Internal URLs only work inside Render's own network.
# Render dashboard → your PostgreSQL → "External Database URL".
# Looks like: postgresql://verifyhub:xxxx@dpg-xxx.singapore-postgres.render.com:5432/verifyhub
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/verifyhub
# Your Telegram user ID(s), comma-separated. Get yours from @userinfobot.
# Only these IDs see the Admin tab — checked server-side on every call.
ADMIN_TELEGRAM_IDS=8455891912
PROJECT_NAME=VerifyHub
UID_PATTERN=^[A-Za-z0-9][A-Za-z0-9_-]{5,63}$
UID_PATTERN_DESCRIPTION=6–64 characters, letters, numbers, dash or underscore.
INIT_DATA_MAX_AGE_SECONDS=86400
SUBMISSION_PER_HOUR=5
API_PER_MINUTE=120
HOST=127.0.0.1
PORT=8000

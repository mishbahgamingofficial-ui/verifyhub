# Copy to .env and fill in real values. NEVER commit a real .env.
# No real credentials are included in this repo.

# Telegram bot token from @BotFather (required for bot + initData validation)
BOT_TOKEN=
# Bot username without @, e.g. verifyhub_bot
BOT_USERNAME=Testing_joinbot
# Public HTTPS URL where the Mini App is served, e.g. https://verify.example.com/
MINI_APP_URL=https://glaxfy.in/frontend/
# Official registration website users must register on (configurable)
REGISTRATION_URL=https://www.dmplay20.com/#/register?invitationCode=77254102278
# Database. Local dev: sqlite:///./verifyhub.db
# Production: postgresql://USER:PASSWORD@HOST:5432/verifyhub
DATABASE_URL=sqlite:///./verifyhub.db
# Comma-separated Telegram user IDs of administrators, e.g. 123456789,987654321
ADMIN_TELEGRAM_IDS=8455891912
# Display name shown in the bot and Mini App
PROJECT_NAME=VerifyHub
# UID validation (server-side, regex). Must match what the registration site issues.
UID_PATTERN=^[A-Za-z0-9][A-Za-z0-9_-]{5,63}$
UID_PATTERN_DESCRIPTION=6–64 characters, letters, numbers, dash or underscore.
# How long a Telegram initData signature stays valid (seconds)
INIT_DATA_MAX_AGE_SECONDS=86400
SUBMISSION_PER_HOUR=5
API_PER_MINUTE=120
# Telegram webhook mode (free tier: the bot runs inside the API service,
# no polling worker). Set these on the API service in Render too.
# Secret Telegram sends back in the X-Telegram-Bot-Api-Secret-Token header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit a real secret.
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this API service, e.g. https://verifyhub-api-uyo8.onrender.com
# The webhook is registered at PUBLIC_BASE_URL + "/telegram/webhook".
PUBLIC_BASE_URL=
HOST=0.0.0.0
PORT=8000
